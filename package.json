{
  "name": "@orch8.io/sdk",
  "version": "0.7.0",
  "description": "Node.js SDK for Orch8 workflow engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orch8-typegen": "dist/typegen/cli.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./push": {
      "import": {
        "types": "./dist/push/index.d.ts",
        "default": "./dist/push/index.js"
      },
      "require": {
        "types": "./dist/push/index.d.ts",
        "default": "./dist/push/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "./typegen": {
      "import": {
        "types": "./dist/typegen/index.d.ts",
        "default": "./dist/typegen/index.js"
      },
      "require": {
        "types": "./dist/typegen/index.d.ts",
        "default": "./dist/typegen/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "require": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai/ai-sdk.d.ts",
        "default": "./dist/ai/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai/ai-sdk.d.ts",
        "default": "./dist/ai/ai-sdk.js"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/ai/openai-agents.d.ts",
        "default": "./dist/ai/openai-agents.js"
      },
      "require": {
        "types": "./dist/ai/openai-agents.d.ts",
        "default": "./dist/ai/openai-agents.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "orch8",
    "workflow",
    "orchestration",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orch8-io/sdk-node.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@orch8/engine-native": ">=0.7.1",
    "express": ">=4",
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "ai": ">=4",
    "@openai/agents": ">=0.1"
  },
  "peerDependenciesMeta": {
    "@orch8/engine-native": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "express": "^4.22.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
