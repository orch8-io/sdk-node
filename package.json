{
  "name": "@orch8.io/sdk",
  "version": "0.7.0",
  "description": "Node.js SDK for Orch8 workflow engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./push": {
      "import": {
        "types": "./dist/push/index.d.ts",
        "default": "./dist/push/index.js"
      },
      "require": {
        "types": "./dist/push/index.d.ts",
        "default": "./dist/push/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "orch8",
    "workflow",
    "orchestration",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orch8-io/sdk-node.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@orch8/engine-native": ">=0.7.1"
  },
  "peerDependenciesMeta": {
    "@orch8/engine-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "vitest": "^3.0.0"
  }
}
